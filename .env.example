# Copy this file to .env and fill in the required values before
# `docker compose up`. See docker-compose.yml for how each is used.
#
# --- One with everything ---
# Every var below, all in one place, for copy-pasting and trimming down to
# what you actually need instead of hunting through the commented-out
# defaults further down for the exact name of each one:
#
#   DOOM_WS_URL=wss://doom.example.com
#   PASSWORD=changeme
#   USE_LOGIN_NAME=true
#   WEB_HTTP_PORT=2344
#   GATEWAY_WS_PORT=2343
#   DOOM_SERVER_PORT=2342
#   WAD_DIR=./wads
#   DOOM_IWAD_PATH=DOOM2.WAD
#   DOOM_PWAD_PATH=MYMAPS.WAD
#   DOOM_DEH_PATH=PATCH.DEH
#   DOOM_EXTRA_ARGS=-skill 4 -deathmatch -fast -warp 5 -timer 10
#   PUID=1000
#   PGID=1000

# --- Required, no sensible default ---

# The websocket URL browsers will connect to. This has to be reachable from
# wherever your players are, not just from inside the docker network - it's
# baked into the client's config.json at container start, not build time, so
# you never need to rebuild the nginx image to change this.
#
# Recommended: a separate hostname from your website, on a plain/unproxied
# DNS record straight to your home IP (not behind a remote CDN proxy, which
# would add real latency to real-time game traffic), with a local reverse
# proxy like nginx-proxy-manager terminating TLS for it - see the README's
# "Putting this behind a reverse proxy / TLS" section for exactly how.
DOOM_WS_URL=wss://notproxied.example.com

# --- Optional, sensible defaults shown ---

# Shared HTTP Basic Auth password guarding the web client and the IWAD
# download - this is what keeps commercial WADs from being publicly
# downloadable. Use a real password, not this placeholder.
#
# The username is never checked - players can type any username, and it
# becomes their in-game player name. Leave PASSWORD itself blank/unset for a
# public server with nothing to gate (e.g. a Freedoom IWAD instead of a
# commercial one) - the login prompt still appears so players can pick a
# name, but any password (including none) is accepted.
PASSWORD=changeme

# Whether the login username becomes the in-game player name. Set to
# "false" to always use doom-wasm's own random pet name generator instead
# (see net_client.c's NET_GetRandomPetName). Combined with a blank PASSWORD
# above, setting this to "false" too skips the login prompt entirely -
# players go straight into the game with a random name. See nginx/auth.js.
#USE_LOGIN_NAME=true

# Ports, published on the host and listened on inside the container -
# there's only one number to change per line, not a separate host/container
# pair. Defaults sit next to each other (2342/2343/2344) so they're easy to
# remember as a group; change any of them if they collide with something
# else already running on your homelab server.
#DOOM_SERVER_PORT=2342
#GATEWAY_WS_PORT=2343
#WEB_HTTP_PORT=2344

# Host directory mounted read-only into nginx at /wads. Drop your IWAD(s) in
# here.
#WAD_DIR=./wads

# Filename (relative to WAD_DIR) of the IWAD to serve, e.g. DOOM2.WAD.
# Defaults to doom1.wad (the freely redistributable shareware IWAD) so the
# stack boots with nothing configured - see nginx/README or the top-level
# README for where to get an actual copy of doom1.wad if you don't have one
# locally.
#DOOM_IWAD_PATH=doom1.wad

# Filename (relative to WAD_DIR) of a PWAD add-on to load on top of the IWAD,
# e.g. a map pack's MYMAPS.WAD. Unset by default - no PWAD is loaded. Drop
# the .wad file into WAD_DIR alongside your IWAD and point this at it, same
# as DOOM_IWAD_PATH.
#DOOM_PWAD_PATH=

# Filename (relative to WAD_DIR) of a DeHackEd (.deh) patch to apply, e.g.
# a gameplay mod's PATCH.DEH. Unset by default - no patch is applied and the
# game runs unmodified. Drop the .deh file into WAD_DIR alongside your IWAD
# and point this at it, same as DOOM_IWAD_PATH.
#DOOM_DEH_PATH=

# Extra doom-wasm command line flags, space-separated, applied to every
# player equally (they're baked into the config.json every browser fetches,
# not per-client) - e.g. "-skill 4 -deathmatch -warp 2 5" for UV difficulty
# deathmatch starting on E2M5. This matters because Doom's netcode requires
# all players' game settings (skill, episode/map, deathmatch, nomonsters,
# etc.) to match exactly or the game desyncs them - see doom-wasm/src's
# d_net.c consistency check. Unset by default - doom-wasm's own defaults
# apply (skill 3, episode 1 map 1, cooperative). See app.js's extraArgs and
# the chocolate-doom man page for the full flag list.
#DOOM_EXTRA_ARGS=

# The container runs as nginx's own built-in "nginx" user (uid/gid 101) by
# default, which needs to be able to read whatever's in WAD_DIR. If that
# directory is owned by a specific uid/gid on your host instead (e.g. a
# dedicated media/homelab user), set both of these to match it - same
# convention as the linuxserver.io images. Leave both unset to keep the
# 101/101 default.
#PUID=1000
#PGID=1000

# --- Security note ---
# This compose file does not terminate TLS. HTTP Basic Auth sends
# credentials in the clear over plain HTTP, and browsers block plain ws://
# connections from an https:// page outright, so for anything beyond local
# testing this needs a TLS-terminating reverse proxy in front of it rather
# than exposing WEB_HTTP_PORT/GATEWAY_WS_PORT directly to the internet. See
# the README for why that should be a local proxy for the gateway/WAD
# traffic specifically, not a remote one like Cloudflare's standard proxy.
