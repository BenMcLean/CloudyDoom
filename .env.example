# Copy this file to .env and fill in the required values before
# `docker compose up`. See docker-compose.yml for how each is used.

# --- Required, no sensible default ---

# The websocket URL browsers will connect to. This has to be reachable from
# wherever your players are, not just from inside the docker network - it's
# baked into the client's config.json at container start, not build time, so
# you never need to rebuild the nginx image to change this.
#
# Recommended: a separate hostname from your website, on a plain/unproxied
# DNS record straight to your home IP (not behind a remote CDN proxy, which
# would add real latency to real-time game traffic), with a local reverse
# proxy like nginx-proxy-manager terminating TLS for it - see the README's
# "Putting this behind a reverse proxy / TLS" section for exactly how.
DOOM_WS_URL=wss://notproxied.example.com

# HTTP Basic Auth guarding the web client and the IWAD download - this is
# what keeps commercial WADs from being publicly downloadable. Use a real
# password, not this placeholder.
DOOM_AUTH_USER=changeme
DOOM_AUTH_PASS=changeme

# --- Optional, sensible defaults shown ---

# Host ports. Change these if they collide with something else already
# running on your homelab server.
#WEB_HTTP_PORT=8080
#GATEWAY_WS_PORT=8081
#DOOM_SERVER_PORT=2342

# Host directory mounted read-only into nginx at /wads. Drop your IWAD(s) in
# here.
#WAD_DIR=./wads

# Filename (relative to WAD_DIR) of the IWAD to serve, e.g. DOOM2.WAD.
# Defaults to doom1.wad (the freely redistributable shareware IWAD) so the
# stack boots with nothing configured - see nginx/README or the top-level
# README for where to get an actual copy of doom1.wad if you don't have one
# locally.
#DOOM_IWAD_PATH=doom1.wad

# Filename (relative to WAD_DIR) of a PWAD add-on to load on top of the IWAD,
# e.g. a map pack's MYMAPS.WAD. Unset by default - no PWAD is loaded. Drop
# the .wad file into WAD_DIR alongside your IWAD and point this at it, same
# as DOOM_IWAD_PATH.
#DOOM_PWAD_PATH=

# Filename (relative to WAD_DIR) of a DeHackEd (.deh) patch to apply, e.g.
# a gameplay mod's PATCH.DEH. Unset by default - no patch is applied and the
# game runs unmodified. Drop the .deh file into WAD_DIR alongside your IWAD
# and point this at it, same as DOOM_IWAD_PATH.
#DOOM_DEH_PATH=

# nginx runs as its own built-in "nginx" user (uid/gid 101) by default,
# which needs to be able to read whatever's in WAD_DIR. If that directory
# is owned by a specific uid/gid on your host instead (e.g. a dedicated
# media/homelab user), set both of these to match it - same convention as
# the linuxserver.io images. Leave both unset to keep the 101/101 default.
#PUID=1000
#PGID=1000

# --- Security note ---
# This compose file does not terminate TLS. HTTP Basic Auth sends
# credentials in the clear over plain HTTP, and browsers block plain ws://
# connections from an https:// page outright, so for anything beyond local
# testing this needs a TLS-terminating reverse proxy in front of it rather
# than exposing WEB_HTTP_PORT/GATEWAY_WS_PORT directly to the internet. See
# the README for why that should be a local proxy for the gateway/WAD
# traffic specifically, not a remote one like Cloudflare's standard proxy.
